# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_PASSCODE: Optional passcode required to claim the initial Administrator account.
# Leave unset in local preview to use the first-run interactive Admin setup form.
ADMIN_BOOTSTRAP_PASSCODE=""

# SMTP_* (Optional): Configure a real SMTP provider for server-side email notifications.
# When unset, email notifications are logged with status "unconfigured" instead of falsely claiming delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
